<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <!-- xUnit v3 builds as a Microsoft.Testing.Platform executable. `dotnet test`
         is switched to MTP mode via the "test" section in global.json. -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LifeOs.Domain\LifeOs.Domain.csproj" />
    <ProjectReference Include="..\..\src\LifeOs.Application\LifeOs.Application.csproj" />
    <ProjectReference Include="..\..\src\LifeOs.Infrastructure\LifeOs.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\LifeOs.Cli\LifeOs.Cli.csproj" />
  </ItemGroup>

  <!--
    Fixture diagnostics for the runner tests. Embedded under the same logical
    prefix EmbeddedDiagnosticSource looks for, so pointing it at this assembly
    discovers them exactly as it discovers the real ones in Infrastructure.
  -->
  <ItemGroup>
    <EmbeddedResource Include="DiagnosticFixtures\*.sql">
      <LogicalName>LifeOs.Infrastructure.Diagnostics.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Dapper" />
  </ItemGroup>

</Project>
